TELEGRAM_BOT_TOKEN=123456:your_telegram_bot_token

# Chat API. Use DeepSeek or any OpenAI-compatible chat endpoint.
CHAT_API_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=your_chat_api_key
CHAT_MODEL=deepseek-v4-pro

# Legacy/default API. Kept for backward compatibility.
AI_API_BASE_URL=https://your-api.example.com/v1
AI_API_KEY=your_api_key
AI_MODEL=grok-4.20-fast

# Image API. This can stay on the public API station while chat uses DeepSeek.
IMAGE_API_BASE_URL=https://your-image-api.example.com/v1
IMAGE_API_KEY=your_image_api_key
IMAGE_MODEL=gpt-img-2-medium-2k
IMAGE_ENDPOINT=chat
IMAGE_SIZE=1024x1024

# 可选
BOT_SYSTEM_PROMPT=你是一个简洁、可靠的中文助手。
REQUEST_TIMEOUT_MS=60000
MAX_HISTORY_MESSAGES=4
RESPONSE_MAX_TOKENS=1000

# 流式输出（默认开启）
STREAM_ENABLED=true
STREAM_EDIT_INTERVAL_MS=500

# Azure TTS（可选,仅 /tts 命令需要）
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
AZURE_TTS_MAX_CHARS=1000
